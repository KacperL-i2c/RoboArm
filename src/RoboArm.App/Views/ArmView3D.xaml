<UserControl x:Class="RoboArm.App.Views.ArmView3D"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <DockPanel>
        <Border DockPanel.Dock="Top" Background="#262626" Padding="8,4">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="3D view — schematic (placeholder geometry)" Foreground="#AAA"
                               VerticalAlignment="Center"/>
                    <TextBlock Text="drag = orbit, wheel = zoom" Foreground="#666" Margin="12,0,0,0"
                               VerticalAlignment="Center" FontSize="11"/>
                </StackPanel>
                <Button x:Name="DetachButton" Grid.Column="1" Content="Detach ⤢"
                        Click="OnDetachClick" Padding="8,2" FontSize="11"/>
            </Grid>
        </Border>
        <Border Background="#1E1E1E">
            <Viewport3D x:Name="Viewport" ClipToBounds="True">
                <Viewport3D.Camera>
                    <PerspectiveCamera FieldOfView="45"/>
                </Viewport3D.Camera>
                <ModelVisual3D>
                    <ModelVisual3D.Content>
                        <Model3DGroup>
                            <AmbientLight Color="#5A5A5A"/>
                            <DirectionalLight Color="#BBBBBB" Direction="-1,-1.4,-0.8"/>
                            <DirectionalLight Color="#666677" Direction="1,1,0.6"/>
                        </Model3DGroup>
                    </ModelVisual3D.Content>
                </ModelVisual3D>
            </Viewport3D>
        </Border>
    </DockPanel>
</UserControl>
