<UserControl x:Class="RoboArm.App.Views.AxisCard"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Width="360">
    <Border Background="#2A2A2A" CornerRadius="6" Padding="12" BorderBrush="#444" BorderThickness="1">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <Grid Grid.Row="0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="{Binding Name}" Foreground="White" FontSize="18" FontWeight="Bold"/>
                    <Ellipse Width="10" Height="10" Margin="8,4,0,0" VerticalAlignment="Center"
                             Fill="{Binding DriveEnabled, Converter={StaticResource BoolToGreenRed}}"/>
                </StackPanel>
                <TextBlock Grid.Column="1" Text="{Binding LimitsText}" Foreground="#888"
                           VerticalAlignment="Center"/>
            </Grid>

            <Grid Grid.Row="1" Margin="0,10,0,4">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Foreground="#DDD" FontFamily="Consolas" FontSize="16">
                    <Run Text="{Binding Measured, Mode=OneWay, StringFormat={}{0:F2}°}"/>
                    <Run Text=" cmd "/>
                    <Run Text="{Binding Commanded, Mode=OneWay, StringFormat={}{0:F2}°}"/>
                </TextBlock>
                <Button Grid.Column="1" Content="Set home here" Command="{Binding SetHomeCommand}"
                        Padding="8,2" FontSize="11"/>
            </Grid>

            <ProgressBar Grid.Row="2" Height="14" Minimum="{Binding Min}" Maximum="{Binding Max}"
                         Value="{Binding Measured, Mode=OneWay}" Background="#1A1A1A"
                         Foreground="#3F8CFF" BorderBrush="#444"/>

            <Grid Grid.Row="3" Margin="0,12,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Text="target" Foreground="#888" VerticalAlignment="Center" Margin="0,0,8,0"/>
                <Slider Grid.Column="1" Minimum="{Binding Min}" Maximum="{Binding Max}"
                        Value="{Binding Target, Delay=150}" TickFrequency="10" IsSnapToTickEnabled="False"
                        VerticalAlignment="Center"/>
                <Button Grid.Column="2" Content="Move to" Command="{Binding MoveToCommand}"
                        Padding="10,4" Margin="8,0,0,0" FontWeight="Bold"/>
            </Grid>

            <Grid Grid.Row="4" Margin="0,12,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Button Content="⟵ hold to jog" Padding="8"
                        PreviewMouseLeftButtonDown="OnJogMinusDown"
                        PreviewMouseLeftButtonUp="OnJogUp" MouseLeave="OnJogUp"/>
                <Button Grid.Column="1" Content="hold to jog ⟶" Padding="8"
                        PreviewMouseLeftButtonDown="OnJogPlusDown"
                        PreviewMouseLeftButtonUp="OnJogUp" MouseLeave="OnJogUp"/>
            </Grid>

            <TextBlock Grid.Row="5" Text="Jog = full safety path (planner + guard + watchdogs)"
                       Foreground="#666" FontSize="10" Margin="0,8,0,0"/>
        </Grid>
    </Border>
</UserControl>
